# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Google sign-in (https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application)
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" there,
# e.g. http://127.0.0.1:3000/auth/google/callback
# Leave all three blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Forgot-password emails (optional - uses PHP's mail(); if unset/unconfigured,
# the reset link is just shown on-screen instead, which is fine for local dev)
MAIL_FROM=no-reply@smartstock.local
